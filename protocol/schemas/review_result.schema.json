        "id": {
          "title": "Id",
          "type": "string"
        },
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback"
        }
      },
      "required": [
        "id",
        "correct"
      ],
      "title": "ReviewItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
