{
  "$defs": {
    "AddNode": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "default": "1.13",
          "title": "Protocol Version",
          "type": "string"
        },
        "op": {
          "const": "add_node",
          "default": "add_node",
          "title": "Op",
          "type": "string"
        },
        "parent": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^(?:\\.|[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79}(?:/[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79})*)$",
          "title": "Parent",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,39}$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "parent",
        "name",
        "type"
      ],
      "title": "AddNode",
      "type": "object"
    },
    "ConnectSignal": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "default": "1.13",
          "title": "Protocol Version",
          "type": "string"
        },
        "op": {
          "const": "connect",
          "default": "connect",
          "title": "Op",
          "type": "string"
        },
        "signal": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z_][A-Za-z0-9_]{0,63}$",
          "title": "Signal",
          "type": "string"
        },
        "from_node": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^(?:\\.|[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79}(?:/[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79})*)$",
          "title": "From Node",
          "type": "string"
        },
        "to_node": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^(?:\\.|[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79}(?:/[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79})*)$",
          "title": "To Node",
          "type": "string"
        },
        "method": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z_][A-Za-z0-9_]{0,63}$",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "from_node",
        "to_node",
        "method"
      ],
      "title": "ConnectSignal",
      "type": "object"
    },
    "DisconnectSignal": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "default": "1.13",
          "title": "Protocol Version",
          "type": "string"
        },
        "op": {
          "const": "disconnect",
          "default": "disconnect",
          "title": "Op",
          "type": "string"
        },
        "signal": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z_][A-Za-z0-9_]{0,63}$",
          "title": "Signal",
          "type": "string"
        },
        "from_node": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^(?:\\.|[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79}(?:/[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79})*)$",
          "title": "From Node",
          "type": "string"
        },
        "to_node": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^(?:\\.|[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79}(?:/[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79})*)$",
          "title": "To Node",
          "type": "string"
        },
        "method": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z_][A-Za-z0-9_]{0,63}$",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "from_node",
        "to_node",
        "method"
      ],
      "title": "DisconnectSignal",
      "type": "object"
    },
    "GeneratedFile": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "default": "1.13",
          "title": "Protocol Version",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Path",
          "type": "string"
        },
        "content": {
          "maxLength": 524288,
          "title": "Content",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content",
        "explanation"
      ],
      "title": "GeneratedFile",
      "type": "object"
    },
    "RemoveNode": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "default": "1.13",
          "title": "Protocol Version",
          "type": "string"
        },
        "op": {
          "const": "remove_node",
          "default": "remove_node",
          "title": "Op",
          "type": "string"
        },
        "node": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^(?:\\.|[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79}(?:/[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79})*)$",
          "title": "Node",
          "type": "string"
        }
      },
      "required": [
        "node"
      ],
      "title": "RemoveNode",
      "type": "object"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "default": "1.13",
          "title": "Protocol Version",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback"
        }
      },
      "required": [
        "id",
        "correct"
      ],
      "title": "ReviewItem",
      "type": "object"
    },
    "SceneEdit": {
      "additionalProperties": false,
      "description": "Changes to one scene file; the client applies them in this order.",
      "properties": {
        "protocol_version": {
          "default": "1.13",
          "title": "Protocol Version",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 6,
          "title": "Path",
          "type": "string"
        },
        "changes": {
          "items": {
            "discriminator": {
              "mapping": {
                "add_node": "#/$defs/AddNode",
                "connect": "#/$defs/ConnectSignal",
                "disconnect": "#/$defs/DisconnectSignal",
                "remove_node": "#/$defs/RemoveNode",
                "set_property": "#/$defs/SetProperty"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AddNode"
              },
              {
                "$ref": "#/$defs/SetProperty"
              },
              {
                "$ref": "#/$defs/RemoveNode"
              },
              {
                "$ref": "#/$defs/ConnectSignal"
              },
              {
                "$ref": "#/$defs/DisconnectSignal"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        },
        "explanation": {
          "default": "",
          "maxLength": 1000,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "path",
        "changes"
      ],
      "title": "SceneEdit",
      "type": "object"
    },
    "SetProperty": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "default": "1.13",
          "title": "Protocol Version",
          "type": "string"
        },
        "op": {
          "const": "set_property",
          "default": "set_property",
          "title": "Op",
          "type": "string"
        },
        "node": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^(?:\\.|[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79}(?:/[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79})*)$",
          "title": "Node",
          "type": "string"
        },
        "property": {
          "maxLength": 64,
          "title": "Property",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "node",
        "property",
        "value"
      ],
      "title": "SetProperty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "default": "1.13",
      "title": "Protocol Version",
      "type": "string"
    },
    "type": {
      "const": "review_result",
      "default": "review_result",
      "title": "Type",
      "type": "string"
    },
    "correct": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correct"
    },
    "per_item": {
      "items": {
        "$ref": "#/$defs/ReviewItem"
      },
      "title": "Per Item",
      "type": "array"
    },
    "feedback": {
      "title": "Feedback",
      "type": "string"
    },
    "follow_up_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Follow Up Question"
    },
    "marked_lines": {
      "items": {
        "type": "integer"
      },
      "title": "Marked Lines",
      "type": "array"
    },
    "generated_files": {
      "items": {
        "$ref": "#/$defs/GeneratedFile"
      },
      "title": "Generated Files",
      "type": "array"
    },
    "scene_edits": {
      "items": {
        "$ref": "#/$defs/SceneEdit"
      },
      "maxItems": 1,
      "title": "Scene Edits",
      "type": "array"
    }
  },
  "required": [
    "feedback"
  ],
  "title": "ReviewResult",
  "type": "object"
}
