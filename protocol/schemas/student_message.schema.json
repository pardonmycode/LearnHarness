{
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "default": "1.5",
      "title": "Protocol Version",
      "type": "string"
    },
    "type": {
      "const": "student_message",
      "default": "student_message",
      "title": "Type",
      "type": "string"
    },
    "intent": {
      "default": "chat",
      "enum": [
        "chat",
        "learn",
        "explain",
        "mission",
        "mission_step",
        "project_plan"
      ],
      "title": "Intent",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "experience_level": {
      "default": 0,
      "maximum": 3,
      "minimum": 0,
      "title": "Experience Level",
      "type": "integer"
    },
    "learning_level": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Learning Level"
    },
    "language": {
      "default": "gdscript",
      "enum": [
        "gdscript",
        "python"
      ],
      "title": "Language",
      "type": "string"
    },
    "current_task": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Task"
    },
    "file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File"
    },
    "code_excerpt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Excerpt"
    },
    "excerpt_start_line": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt Start Line"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "skill_focus": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skill Focus"
    },
    "mission_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mission Id"
    },
    "mission_step_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mission Step Id"
    },
    "project_description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Description"
    },
    "project_todos": {
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Project Todos",
      "type": "array"
    },
    "project_question": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Question"
    },
    "message": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "project_id",
    "message"
  ],
  "title": "StudentMessage",
  "type": "object"
}
