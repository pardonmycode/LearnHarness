{
  "$defs": {
    "ProjectTurn": {
      "additionalProperties": false,
      "description": "One question of the helper about the project and the child's answer.",
      "properties": {
        "protocol_version": {
          "default": "1.12",
          "title": "Protocol Version",
          "type": "string"
        },
        "question": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "title": "ProjectTurn",
      "type": "object"
    },
    "SceneConnection": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "default": "1.12",
          "title": "Protocol Version",
          "type": "string"
        },
        "signal": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Signal",
          "type": "string"
        },
        "from_node": {
          "maxLength": 300,
          "minLength": 1,
          "title": "From Node",
          "type": "string"
        },
        "to_node": {
          "maxLength": 300,
          "minLength": 1,
          "title": "To Node",
          "type": "string"
        },
        "method": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "from_node",
        "to_node",
        "method"
      ],
      "title": "SceneConnection",
      "type": "object"
    },
    "SceneContext": {
      "additionalProperties": false,
      "description": "The scene the open script belongs to, as far as the AI needs it.",
      "properties": {
        "protocol_version": {
          "default": "1.12",
          "title": "Protocol Version",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 6,
          "title": "Path",
          "type": "string"
        },
        "root_name": {
          "default": "",
          "maxLength": 80,
          "title": "Root Name",
          "type": "string"
        },
        "script_node": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^(?:\\.|[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79}(?:/[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79})*)$",
          "title": "Script Node",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/SceneNode"
          },
          "maxItems": 150,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/SceneConnection"
          },
          "maxItems": 80,
          "title": "Connections",
          "type": "array"
        }
      },
      "required": [
        "path",
        "script_node",
        "nodes"
      ],
      "title": "SceneContext",
      "type": "object"
    },
    "SceneNode": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "default": "1.12",
          "title": "Protocol Version",
          "type": "string"
        },
        "path": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^(?:\\.|[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79}(?:/[^\"\\\\\\[\\]\\n:%@/.][^\"\\\\\\[\\]\\n:%@/]{0,79})*)$",
          "title": "Path",
          "type": "string"
        },
        "type": {
          "default": "",
          "maxLength": 64,
          "title": "Type",
          "type": "string"
        },
        "instance": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance"
        },
        "script": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 8,
          "title": "Properties"
        }
      },
      "required": [
        "path"
      ],
      "title": "SceneNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "default": "1.12",
      "title": "Protocol Version",
      "type": "string"
    },
    "type": {
      "const": "student_message",
      "default": "student_message",
      "title": "Type",
      "type": "string"
    },
    "intent": {
      "default": "chat",
      "enum": [
        "chat",
        "learn",
        "explain",
        "mission",
        "mission_step",
        "project_plan",
        "review"
      ],
      "title": "Intent",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "experience_level": {
      "default": 0,
      "maximum": 3,
      "minimum": 0,
      "title": "Experience Level",
      "type": "integer"
    },
    "learning_level": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Learning Level"
    },
    "language": {
      "default": "gdscript",
      "enum": [
        "gdscript",
        "python"
      ],
      "title": "Language",
      "type": "string"
    },
    "current_task": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Task"
    },
    "file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File"
    },
    "code_excerpt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Excerpt"
    },
    "excerpt_start_line": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt Start Line"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "skill_focus": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skill Focus"
    },
    "mission_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mission Id"
    },
    "mission_step_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mission Step Id"
    },
    "mission_from_project": {
      "default": false,
      "title": "Mission From Project",
      "type": "boolean"
    },
    "project_hint_level": {
      "anyOf": [
        {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Hint Level"
    },
    "project_description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Description"
    },
    "project_question": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Question"
    },
    "project_turns": {
      "items": {
        "$ref": "#/$defs/ProjectTurn"
      },
      "maxItems": 12,
      "title": "Project Turns",
      "type": "array"
    },
    "project_skipped_questions": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "title": "Project Skipped Questions",
      "type": "array"
    },
    "project_done_missions": {
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Project Done Missions",
      "type": "array"
    },
    "scene": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_actions": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Input Actions",
      "type": "array"
    },
    "project_files": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Project Files",
      "type": "array"
    },
    "message": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "project_id",
    "message"
  ],
  "title": "StudentMessage",
  "type": "object"
}
