    "SceneEdit": {
      "additionalProperties": false,
      "description": "Changes to one scene file; the client applies them in this order.",
      "properties": {
        "protocol_version": {
          "default": "1.12",
          "title": "Protocol Version",
          "type": "string"
        },
        "path": {
          "maxLength": 500,
          "minLength": 6,
          "title": "Path",
          "type": "string"
        },
        "changes": {
          "items": {
            "discriminator": {
              "mapping": {
                "add_node": "#/$defs/AddNode",
                "connect": "#/$defs/ConnectSignal",
                "disconnect": "#/$defs/DisconnectSignal",
                "remove_node": "#/$defs/RemoveNode",
                "set_property": "#/$defs/SetProperty"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AddNode"
              },
              {
                "$ref": "#/$defs/SetProperty"
              },
              {
                "$ref": "#/$defs/RemoveNode"
              },
              {
                "$ref": "#/$defs/ConnectSignal"
              },
              {
                "$ref": "#/$defs/DisconnectSignal"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        },
        "explanation": {
          "default": "",
          "maxLength": 1000,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "path",
        "changes"
      ],
      "title": "SceneEdit",
      "type": "object"
    },
