            },
            {
              "$ref": "#/$defs/OrderingExercise"
            },
            {
              "$ref": "#/$defs/FindBugExercise"
            },
            {
              "$ref": "#/$defs/TextBlanksExercise"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exercise"
    },
    "mission": {
      "anyOf": [
        {
          "$ref": "#/$defs/Mission"
        },
        {
          "type": "null"
        }
      ],
      "default": null
