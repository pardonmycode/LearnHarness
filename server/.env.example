# Copy to .env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=bitte-lang-und-zufaellig
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=learnserver,localhost
# With HTTPS through a proxy: DJANGO_SECURE=1 and the public origin here.
DJANGO_SECURE=0
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=learnharness
POSTGRES_USER=learnharness
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backups (service "backup"): daily pg_dump into server/backups/.
# Time of day (HH:MM, time zone TZ) and how many days dumps are kept.
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
TZ=Europe/Berlin
